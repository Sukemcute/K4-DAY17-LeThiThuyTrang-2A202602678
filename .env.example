# Offline is the default. Benchmark calls a real model only with --live.
LAB_OFFLINE=true
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
# OPENAI_API_KEY=replace-with-your-key
# GEMINI_API_KEY=...
# ANTHROPIC_API_KEY=...
# OPENROUTER_API_KEY=...
# OPENROUTER_MODEL=openai/gpt-4o-mini
# GEMINI_MODEL=gemini-2.5-flash
# ANTHROPIC_MODEL=claude-sonnet-4-5
# OLLAMA_MODEL=llama3.2
# CUSTOM_MODEL=local-model
# OPENAI_STORE=true
# CUSTOM_BASE_URL=http://localhost:8000/v1
# CUSTOM_API_KEY=local-key
# OLLAMA_BASE_URL=http://localhost:11434
COMPACT_THRESHOLD_TOKENS=1200
COMPACT_KEEP_MESSAGES=4
SUMMARY_MAX_CHARS=1600
PROFILE_CONFIDENCE_THRESHOLD=0.85
# Optional judge configuration; offline benchmark uses the documented heuristic.
# JUDGE_PROVIDER=openai
# JUDGE_MODEL=gpt-4o-mini
